{
  "id": "crowley",
  "name": "David Crowley for Wisconsin",
  "platform": "sb",
  "output": {
    "mode": "document",
    "template": "template.html"
  },
  "defaultPage": "https://secure.actblue.com/donate/dcrowley-email",
  "merge": {
    "firstName": "{{ sb_first_name or 'Friend' }}",
    "firstNameSubject": "{{ sb_first_name or 'Friend' }}",
    "ask": "{{ ask{n} }}"
  },
  "prevGiftField": "sb_max_amount_donated",
  "asks": [
    {
      "mult": 1,
      "min": 10,
      "max": 50
    },
    {
      "mult": 1.2,
      "min": 25,
      "max": 100
    },
    {
      "mult": 1.5,
      "min": 50,
      "max": 250
    },
    {
      "mult": 2,
      "min": 100,
      "max": 500
    },
    {
      "mult": 3,
      "min": 250,
      "max": 1000
    },
    {
      "mult": 5,
      "min": 500,
      "max": 2500
    }
  ],
  "refcode": {
    "mode": "append"
  },
  "tokens": {},
  "typos": {},
  "rules": [
    "spaces",
    "spaceBeforePunct",
    "spaceAfterPeriod",
    "spaceAfterComma",
    "repeatedWord",
    "doublePeriods",
    "typos",
    "smartQuotes",
    "ctaLink"
  ],
  "bodyFontSize": 18,
  "imageWidth": 536,
  "buttons": {
    "single": "DONATE &rarr;",
    "another": "ANOTHER AMOUNT &rarr;"
  },
  "expressDisclaimer": "If you have saved your information with ActBlue Express, your donation will process instantly.",
  "toggles": [
    {
      "id": "logo",
      "label": "Top logo",
      "default": true
    },
    {
      "id": "footerbox",
      "label": "Footer box",
      "default": true
    }
  ],
  "style": {
    "ink": "#1B2733",
    "bar": "#2E3690",
    "panel": "#EBF3FE",
    "btnBg": "#2E3690",
    "btnEdge": "#1C2160",
    "btnText": "#FFFFFF",
    "ghostBg": "#FFFFFF",
    "ghostBorder": "#2E3690",
    "ghostText": "#2E3690",
    "btnFont": "Arial,Helvetica,sans-serif",
    "btnSize": 16,
    "btnWeight": 700,
    "letterSpacing": "0.6px",
    "hiBg": "#FFC200",
    "hiEdge": "#C79200",
    "hiText": "#1B2733"
  },
  "stack": {
    "count": 4,
    "columns": 1,
    "highlight": 0
  },
  "snippets": {},
  "plainFooter": "Crowley for Wisconsin\nPO Box 510031\nMilwaukee, WI 53203\n\nPAID FOR BY CROWLEY FOR WISCONSIN\n\nYou can also sign up to receive fewer emails: https://forms.oneswitchboard.com/crowley-for-wisconsin/fewer-emails\nWe hope you'll stay because emails are such an important part of how we organize and keep in touch.\n\nIf you believe you received this message in error or wish to no longer receive email from us, please click here: {{ sb_unsubscribe }}"
}
